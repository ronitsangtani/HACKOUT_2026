rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check if the current user owns the document by UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection: users/{uid}
    // Users can only read and write their own personal profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Activities collection: activities/{activityId}
    // Users can only access and log their own activity records
    match /activities/{activityId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Recommendations catalog: recommendations/{recommendationId}
    // Authenticated users can browse recommendations; only backend admin can write
    match /recommendations/{recommendationId} {
      allow read: if isAuthenticated();
      allow write: if false; // Managed by backend / admin
    }

    // 4. User Actions collection: user_actions/{actionId}
    // Tracks circular habits adopted by individual users
    match /user_actions/{actionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 5. Rewards collection: rewards/{rewardId}
    // Users can view rewards credited to their account
    match /rewards/{rewardId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
